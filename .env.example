# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Find these values in your Supabase dashboard:
#   Settings → API → Project URL & API Keys

# Your project's REST/Auth endpoint
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key  — used in production (respects RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — DEV ONLY, bypasses RLS for testing before auth is wired up
# Remove this variable entirely once the auth sprint (Sprint 24) is complete.
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Temporary fixed user UUID used during dev (Sprint 23) before real auth exists.
# Generate any valid UUID: https://www.uuidgenerator.net/
# Remove once Sprint 24 auth is wired up.
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000000
