# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Find these values in your Supabase dashboard:
#   Settings → API → Project URL & API Keys

# Your project's base URL (no trailing path — the JS client adds /rest/v1/ itself)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in client-side code.
# Row Level Security policies (migration 002) ensure users only see their own data.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Local dev / testing bypass ──────────────────────────────────────────────
# Set to "true" in .env.development.local to skip the Supabase auth gate and
# go straight to the app shell (localStorage-only mode, no sign-in required).
#
# Usage:
#   1. Create .env.development.local (already gitignored)
#   2. Add: VITE_DISABLE_AUTH=true
#   3. Run `npm run dev` — you'll land directly in the app.
#
# NEVER set this in .env.local or any file that could reach production.
# VITE_DISABLE_AUTH=true
