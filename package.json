    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.3.0",
